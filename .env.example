# ==============================================
# RAG PROJECT - ENVIRONMENT VARIABLES EXAMPLE
# ==============================================
# Copy this file to .env and fill with your actual values

# Application Settings
APP_ENV=production
APP_DEBUG=false
SERVER_NAME=localhost

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_EXTERNAL_PORT=
DB_DATABASE=<your_rag_db>
DB_USERNAME=<your_rag_user>
DB_PASSWORD=<your_secure_database_password_here>

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<your_secure_redis_password_here>

# LLM Service Configuration
LLAMA_CPP_URL=http://llm-service:8080
LLM_TIMEOUT=300
LLM_MODEL_PATH=/models/qwen2.5-7b-instruct-q4_k_m.gguf

# LLM Parameters
MODEL_NAME=qwen2.5-7b-instruct-q4_k_m.gguf
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1
LLM_CONTEXT_SIZE=4096

# LLM Service Resources
LLM_MEMORY_LIMIT=8G
LLM_MEMORY_RESERVATION=5G
LLM_CPU_CORES=2

# Embedding Configuration
EMBEDDING_DIMENSION=1536
CHUNK_OVERLAP=50

# Vector Search Configuration
VECTOR_SEARCH_THRESHOLD=0.3
VECTOR_SEARCH_LIMIT=5
CHUNK_SIZE=300

# Maximum file size in bytes (default is 20MB)
MAX_UPLOAD_FILE_SIZE=20971520

# External Ports (only expose what's necessary)
APP_HTTP_PORT=8080
APP_HTTPS_PORT=8443

# Logging Configuration
LOG_FILE=/app/storage/logs/app.log

# Storage Configuration
STORAGE_UPLOAD_PATH=/app/storage/uploads/

# RabbitMQ Configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=<your_rabbitmq_user>
RABBITMQ_PASSWORD=<your_rabbitmq_password>
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_AMQP_PORT=5672

# Redis Task Cache Configuration
REDIS_TASK_CACHE_PREFIX=rag_task_

# Hybrid Search Configuration (BM25 + Vector)
HYBRID_SEARCH_VECTOR_TOP_K=10
HYBRID_SEARCH_KEYWORD_TOP_K=10
HYBRID_SEARCH_RRF_K=60

# Health Check Configuration
HEALTH_CHECK_URL=

# Blue-Green Deployment Ports
BLUE_PORT=8080
GREEN_PORT=8081
LB_PORT=8082
BLUE_HTTPS_PORT=8440
GREEN_HTTPS_PORT=8441