# ==============================================
# RAG PROJECT - ENVIRONMENT VARIABLES EXAMPLE
# ==============================================
# Copy this file to .env and fill with your actual values

# Application Settings
APP_ENV=production
APP_DEBUG=false
SERVER_NAME=localhost

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=<your_rag_db>
DB_USERNAME=<your_rag_user>
DB_PASSWORD=<your_secure_database_password_here>

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<your_secure_redis_password_here>

# LLM Service Configuration
LLAMA_CPP_URL=http://llm-service:8080
LLM_TIMEOUT=90
LLM_MODEL_PATH=/models/tinyllama-1.1b-chat-v1.0.Q4_K_M.gguf

# Vector Search Configuration

# Similarity threshold for vector search
VECTOR_SEARCH_THRESHOLD=0.001
# Maximum number of documents found for a context
VECTOR_SEARCH_LIMIT=5
# Text fragment size in characters when splitting documents
CHUNK_SIZE=300

# External Ports (only expose what's necessary)
APP_HTTP_PORT=8080
APP_HTTPS_PORT=8443

# ==============================================
# SECURITY NOTES:
# ==============================================
# 1. Use strong passwords for production
# 2. Don't expose database/redis ports externally
# 3. Keep .env file out of version control
# 4. Use different passwords for each environment
# 5. Consider using Docker secrets for production

# ==============================================
# QUICK SETUP:
# ==============================================
# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your values
# 3. Run: docker-compose up -d
